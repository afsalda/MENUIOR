# Publish the Items tab as CSV and paste its URL here. Never add private Sheet URLs or secrets.
VITE_SHEET_CSV_URL=
# Publish Settings as a second CSV tab (same Google Sheet).
VITE_SETTINGS_CSV_URL=
# Optional. No analytics code loads when this is blank.
VITE_GA4_ID=
# Hosted runtime only: cafe owner email, verified against Sites identity headers.
# Configure ADMIN_EMAIL in Sites, never as a VITE_ browser variable.
ADMIN_EMAIL=
